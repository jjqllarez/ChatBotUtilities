# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Asistente LLM (OpenRouter) - necesaria para el LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Notas de voz: transcripción con Gemini vía OpenRouter
TRANSCRIBE_MODEL=google/gemini-2.5-flash-lite

# Anti-baneo de WhatsApp
WA_MIN_GAP_MS=1200
WA_MAX_DAILY_MSGS=1500

# Memoria del LLM (limpieza diaria)
HISTORY_CLEAN_HOUR=3
HISTORY_RETAIN_HOURS=24

# Chromium para PDF/imagen/card (ruta del binario en el VPS, p. ej. /usr/bin/chromium-browser)
CHROME_PATH=

# Puerto del servidor HTTP del QR (solo primera vinculación)
QR_PORT=8080
